<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azulPrincipal"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Barra superior -->
    <TextView
        android:id="@+id/txtTitulo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/txtTitulo"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Contenido -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondoCatalogo"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Filtro por carrera -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filtro"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/txtFiltrar"
                android:textColor="@color/textoGris"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spnCarreras"
                android:layout_width="match_parent"
                android:layout_height="40dp" />
        </LinearLayout>

        <!-- Lista de cursos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvCursos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            tools:listitem="@layout/item_curso"
            tools:spanCount="2"
            tools:layoutManager="androidx.recyclerview.widget.GridLayoutManager" />

        <!-- Se muestra cuando la carrera no tiene cursos -->
        <TextView
            android:id="@+id/txtSinCursos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/txtSinCursos"
            android:textColor="@color/textoGris"
            android:textSize="16sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnVerRegistros"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/azulPrincipal"
            android:text="@string/btnVerRegistros"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
