<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/azulPrincipal"
    android:orientation="vertical"
    tools:context=".Vista.VerRegistroActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btnAtras"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/btnAtras"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/txtTituloRegistros"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/fondoCatalogo"
        android:orientation="vertical"
        android:padding="12dp">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filtro"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="8dp"
            android:paddingEnd="4dp"
            android:paddingBottom="4dp">

            <ImageView
                android:id="@+id/imgCarrera"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/txtFiltrar"
                android:src="@drawable/engrane" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/txtFiltrar"
                    android:textColor="@color/textoGris"
                    android:textSize="12sp" />


                <Spinner
                    android:id="@+id/spnCarreras"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:entries="@array/carreras" />
            </LinearLayout>
        </LinearLayout>

        <!-- Total de inscritos -->
        <TextView
            android:id="@+id/txtTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="end"
            android:text="Total: 0"
            android:textColor="@color/textoOscuro"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Lista de cursos -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Curso 1 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurso1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="64dp"
                            android:background="@color/grisImagen"
                            android:contentDescription="@string/imgCurso"
                            android:scaleType="centerCrop"
                            android:src="@drawable/programacion" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="PROGRAMACIÓN AVANZADA"
                                android:textColor="@color/textoOscuro"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbInscritos1"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="6dp"
                                android:max="50"
                                android:progressBackgroundTint="@color/grisImagen"
                                android:progressTint="@color/azulPrincipal" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtInscritos1"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0 inscritos"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/txtCupo1"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50 total"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Curso 2 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurso2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="64dp"
                            android:background="@color/grisImagen"
                            android:contentDescription="@string/imgCurso"
                            android:scaleType="centerCrop"
                            android:src="@drawable/basedatos" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="BASES DE DATOS II"
                                android:textColor="@color/textoOscuro"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbInscritos2"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="6dp"
                                android:max="50"
                                android:progressBackgroundTint="@color/grisImagen"
                                android:progressTint="@color/azulPrincipal" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtInscritos2"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0 inscritos"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/txtCupo2"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50 total"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Curso 3 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurso3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="64dp"
                            android:background="@color/grisImagen"
                            android:contentDescription="@string/imgCurso"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ia" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="INTELIGENCIA ARTIFICIAL"
                                android:textColor="@color/textoOscuro"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbInscritos3"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="6dp"
                                android:max="40"
                                android:progressBackgroundTint="@color/grisImagen"
                                android:progressTint="@color/azulPrincipal" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtInscritos3"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0 inscritos"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/txtCupo3"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="40 total"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Curso 4 -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardCurso4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="10dp"
                    app:cardElevation="3dp"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <ImageView
                            android:layout_width="96dp"
                            android:layout_height="64dp"
                            android:background="@color/grisImagen"
                            android:contentDescription="@string/imgCurso"
                            android:scaleType="centerCrop"
                            android:src="@drawable/redes" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="REDES DE COMPUTADORAS"
                                android:textColor="@color/textoOscuro"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <ProgressBar
                                android:id="@+id/pbInscritos4"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="10dp"
                                android:layout_marginTop="6dp"
                                android:max="50"
                                android:progressBackgroundTint="@color/grisImagen"
                                android:progressTint="@color/azulPrincipal" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/txtInscritos4"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="0 inscritos"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/txtCupo4"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="50 total"
                                    android:textColor="@color/textoGris"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </ScrollView>

        <Button
            android:id="@+id/btnVolverCatalogo"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="@color/azulPrincipal"
            android:text="@string/btnVolverCatalogo"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>